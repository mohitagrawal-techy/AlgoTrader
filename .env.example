# Copy to .env and fill in. .env is gitignored.
ALGOVERSE_UPSTOX_API_KEY=
ALGOVERSE_UPSTOX_API_SECRET=
# Must match the redirect URL registered on your Upstox app exactly.
ALGOVERSE_UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
ALGOVERSE_DATA_DIR=data

# AWS access for `algoverse history-s3` (read, config/history_s3.yaml) and the daily
# upload of recorded data (write under algoverse/ only, config/archive_s3.yaml).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=